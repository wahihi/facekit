# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Claude Code harness runtime state (not project source)
.claude/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Embedding model weights — not committed to the repo (large binaries; some are
# also research-licensed/non-redistributable). Only manifest.json is tracked.
# Matches both the package's own assets/ and example/assets/.
#
# auraface: bundled/redistributable license, but still >100MB, so it is
# distributed via a GitHub Release instead of git — see tool/fetch_models.sh.
# It stays covered by the wildcard below (no ! exception), same as the other
# embedding models.
**/assets/models/*/*.tflite
!assets/models/blazeface_short/*.tflite
!assets/models/face_landmark_478/*.tflite
!assets/models/yunet_160/*.tflite

# tool/model_verification/ local run artifacts — the scripts there download/
# fetch these into place themselves (see the folder's README), and some are
# personal photos or third-party datasets that must never be committed.
# results_*.json (the actual measurement output) is intentionally NOT
# covered here — those are the checked-in evidence behind manifest
# threshold values, see e.g. results_2026-06-25.json.
tool/model_verification/models/
tool/model_verification/*.onnx
tool/model_verification/*.jpg
tool/model_verification/*.jpeg
tool/model_verification/*.png
tool/model_verification/*.parquet
tool/model_verification/*.npy
# onnx2tf's local saved_model + tflite conversion working directory (e.g.
# yunet_tflite_out/) — the actual shipped output is copied to
# assets/models/<name>/ by hand; this dir is just onnx2tf's scratch space.
tool/model_verification/*_tflite_out/

# flutter run --dart-define=FACEKIT_VERBOSE_DEBUG=true device logs saved for
# local analysis (tool/analyze_alignment_log.py) — contains base64 face crop
# dumps, never meant to be committed.
example/test/log.test
example/test/log_*.test

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/
